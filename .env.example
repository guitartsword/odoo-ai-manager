# Odoo XML-RPC connection. ODOO_TOKEN is an Odoo API key.
ODOO_VERSION=16.0
ODOO_URL=https://odoo.example.com
ODOO_DB=odoo
ODOO_USERNAME=integration@example.com
ODOO_TOKEN=replace-me

# review: preview and confirm each draft; direct: create allowlisted drafts
# without an additional per-action approval. Destructive actions always need
# explicit confirmation.
ODOO_DRAFT_WORKFLOW=review
